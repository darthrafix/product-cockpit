# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# NextAuth — gere um secret aleatório: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://seu-app.railway.app

# Microsoft / Azure AD
# Crie em: portal.azure.com → Azure Active Directory → App registrations
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=          # ID do tenant (ou omita para multi-tenant)

# Permissões — emails separados por vírgula
# admin: acesso total (criar, atualizar, comentar work items)
# member: leitura + comentários
# viewer: leitura apenas (qualquer um que logar com Microsoft vira viewer por padrão)
ADMIN_EMAILS=rafaela@suaempresa.com
MEMBER_EMAILS=pd@suaempresa.com,eng@suaempresa.com

# Figma (para ler o FigJam)
FIGMA_ACCESS_TOKEN=

# Azure DevOps
ADO_ORG=
ADO_PROJECT=
ADO_PAT=
